# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis
# na Vercel / Netlify (Site settings → Environment variables).

# Supabase → Project Settings → API (públicas, podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Domínio fictício usado como e-mail interno dos técnicos (nenhum e-mail é enviado).
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=chamados.local

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...).
# SÓ SERVIDOR. Nunca use prefixo NEXT_PUBLIC_ nem faça commit deste valor.
SUPABASE_SECRET_KEY=

# URL pública do app (links nas notificações e no QR Code). Sem barra no fim.
APP_URL=

# Segredo que o pg_cron envia para /api/cron/alertas (README, seção 10). Mínimo 32 caracteres.
CRON_SECRET=

# --- Login com Feishu/Lark para quem abre chamado (README, seção 15) ---
# Assina a sessão do solicitante. Mínimo 32 caracteres aleatórios.
SESSAO_SECRET=
# App próprio do Feishu (open.feishu.cn). Com estes dois preenchidos, o formulário exige login.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Opcionais: permissões extras (e-mail/celular) e trava por empresa.
# FEISHU_SCOPES=contact:user.email:readonly contact:user.phone:readonly
# FEISHU_TENANT_KEY=
# Mesmo esquema para o Lark (open.larksuite.com):
# LARK_APP_ID=
# LARK_APP_SECRET=
# Para deixar o login opcional mesmo com o app configurado:
# FORMULARIO_EXIGE_LOGIN=false
